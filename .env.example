DISCORD_TOKEN=
# Home guild: members of this server are authorized. Optional if you set
# AUTHORIZED_USER_IDS. Leave blank for a pure user-installed app.
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to run scans anywhere the app is
# installed (DMs, user-install). Required if DISCORD_GUILD_ID is blank.
AUTHORIZED_USER_IDS=
SHROODLER_BIN=shroodler
SHROODLER_EXTRA_FLAGS=
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_SECONDS=1800
SESSIONS_DIR=~/.shroodler/bot-sessions

# Sherlock (username OSINT) — powers /sherlock. Install sherlock-project and
# put it on PATH, or point SHERLOCK_BIN at the binary.
SHERLOCK_BIN=sherlock
SHERLOCK_EXTRA_FLAGS=
# Per-username lookup timeout in seconds
SHERLOCK_TIMEOUT_SECONDS=300

# LLM provider: "anthropic" (default) or "deepseek"
LLM_PROVIDER=anthropic
# Model override — leave blank to use the provider default
# anthropic default: claude-sonnet-5
# deepseek default:  deepseek-chat  (use deepseek-reasoner for R1)
LLM_MODEL=

# Drive scans with the LLM agent loop so its per-iteration reasoning streams
# to the Discord thread (set false for a cheaper deterministic scan).
LLM_AGENT=true

# API keys — only the one matching LLM_PROVIDER is required
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
