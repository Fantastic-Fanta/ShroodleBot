DISCORD_TOKEN=
DISCORD_GUILD_ID=
SHROODLER_BIN=shroodler
SHROODLER_EXTRA_FLAGS=
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_SECONDS=1800
SESSIONS_DIR=~/.shroodler/bot-sessions

# LLM provider: "anthropic" (default) or "deepseek"
LLM_PROVIDER=anthropic
# Model override — leave blank to use the provider default
# anthropic default: claude-sonnet-5
# deepseek default:  deepseek-chat  (use deepseek-reasoner for R1)
LLM_MODEL=

# Drive scans with the LLM agent loop so its per-iteration reasoning streams
# to the Discord thread (set false for a cheaper deterministic scan).
LLM_AGENT=true

# API keys — only the one matching LLM_PROVIDER is required
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
